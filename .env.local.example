# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# Supabase project URL and anon key.
# Safe to expose to the browser: the anon key grants nothing on its own, and
# every request it makes is checked against the RLS policies in
# supabase/migrations/0002_rls.sql using the caller's JWT.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. BYPASSES ALL ROW LEVEL SECURITY.
# Server-side only. Never prefix this with NEXT_PUBLIC_. If it leaks, rotate it
# immediately in the Supabase dashboard — anyone holding it has full read/write
# access to every table, including account_secrets.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Non-routable domain used to synthesize an email address per username, because
# Supabase Auth requires one and HeyChat deliberately collects neither email nor
# phone. Nothing is ever sent to it. Use a domain you control or a reserved TLD
# (.invalid / .internal) so mail can never accidentally escape.
# Changing this after users exist will break their logins — see FOLLOWUPS.md #7.
HEYCHAT_SYNTHETIC_EMAIL_DOMAIN=accounts.heychat.invalid

# ---------------------------------------------------------------------------
# Web Push (notifications). Generate a pair with:  npm run push:keys
#
# Optional: leave these unset and the app runs exactly as before, with the
# notification toggle in Settings reporting that push is not configured. Nothing
# else changes and nothing breaks.
#
# ROTATING THESE UNSUBSCRIBES EVERYONE. A browser binds its subscription to the
# public key it subscribed with, so new keys mean every stored endpoint starts
# being rejected and every device goes quiet until it next opens the app.
# ---------------------------------------------------------------------------

# Safe in the browser — the subscribing client hands it to the push service by
# design. This is the one VAPID value that is *meant* to be public.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Signs push requests. Server-side only; never prefix with NEXT_PUBLIC_.
VAPID_PRIVATE_KEY=

# How a push service contacts whoever runs this app if it starts misbehaving.
# Never shown to users. A mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Shared secret for POST /api/cron/sweep-media, which deletes the attachments
# belonging to already-expired disappearing messages.
#
# The caller is a scheduler, not a person, so there is no session to check —
# send it as `Authorization: Bearer <secret>`. With this UNSET the route refuses
# every request rather than defaulting to open, so leaving it blank is safe;
# expired messages still get deleted by the pg_cron job, their attachments just
# accumulate. Any long random string will do:  openssl rand -base64 32
# ---------------------------------------------------------------------------
CRON_SECRET=
