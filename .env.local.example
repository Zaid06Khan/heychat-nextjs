# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# Supabase project URL and anon key.
# Safe to expose to the browser: the anon key grants nothing on its own, and
# every request it makes is checked against the RLS policies in
# supabase/migrations/0002_rls.sql using the caller's JWT.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. BYPASSES ALL ROW LEVEL SECURITY.
# Server-side only. Never prefix this with NEXT_PUBLIC_. If it leaks, rotate it
# immediately in the Supabase dashboard — anyone holding it has full read/write
# access to every table, including account_secrets.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Non-routable domain used to synthesize an email address per username, because
# Supabase Auth requires one and HeyChat deliberately collects neither email nor
# phone. Nothing is ever sent to it. Use a domain you control or a reserved TLD
# (.invalid / .internal) so mail can never accidentally escape.
# Changing this after users exist will break their logins — see FOLLOWUPS.md #7.
HEYCHAT_SYNTHETIC_EMAIL_DOMAIN=accounts.heychat.invalid
